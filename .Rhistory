# Set Up
library(tidyverse)
library(lubridate)
spotify_songs_cleaned <- read_csv("spotify_cleaned.csv")
ggplot(spotify_songs_cleaned, aes(x = key, y = track_popularity)) +
geom_point(position = position_jitter(seed=100)) +
theme_minimal() +
labs(title = "Key and Track Popularity",
x = "Key",
y = "Track Popularity")
ggplot(spotify_songs_cleaned, aes(x = loudness, y = track_popularity)) +
#geom_point(position = position_jitter(seed=100)) +
geom_point(position = position_jitter(seed=100)) +
theme_minimal() +
labs(title = "Loudness and Track Popularity",
x = "Loudness",
y = "Track Popularity")
ggplot(spotify_songs_cleaned,
aes(x = loudness, y = track_popularity)) +
geom_bar(mapping = NULL,
stat = "count",
position = "stack") +
ggplot(spotify_songs_cleaned,
aes(x = loudness, y = track_popularity)) +
geom_bar(mapping = NULL,
stat = "count",
position = "stack") +
ggplot(spotify_songs_cleaned,
aes(x = loudness, y = track_popularity)) +
geom_bar(stat = "count",
position = "stack",
fill = "steelblue") +
theme_minimal()
ggplot(spotify_songs_cleaned,
aes(x = loudness, y = track_popularity)) +
geom_bar(stat = "loudness",
position = "stack",
fill = "steelblue") +
theme_minimal()
ggplot(spotify_songs_cleaned,
aes(x = loudness, y = track_popularity)) +
geom_bar(stat = "bin",
position = "stack",
fill = "steelblue") +
theme_minimal()
ggplot(spotify_songs_cleaned,
aes(x = loudness, y = track_popularity)) +
geom_bar(alpha = 0.6) +
theme_minimal()
ggplot(spotify_songs_cleaned,
aes(x = loudness, y = track_popularity)) +
geom_bar(alpha = 0.6) +
theme_minimal() +
labs(title = "Loudness and Track Popularity",
x = "Loudness",
y = "Track Popularity")
spotify_songs_cleaned |>
mutate(loudness_bin = cut(loudness, breaks = 10)) |>
group_by(loudness_bin) |>
summarize(avg_popularity = mean(track_popularity)) |>
ggplot(aes(x = loudness_bin, y = avg_popularity)) +
geom_col(fill = "steelblue") +
theme_minimal() +
labs(x = "Loudness bins", y = "Avg popularity")
ggplot(spotify_songs_cleaned, aes(x = loudness)) +
geom_histogram(bins = 20) +
theme_minimal() +
labs(title = "Analysis of loudness in top songs",
x = "Loudness")
ggplot(spotify_songs_cleaned, aes(x = loudness)) +
geom_histogram(bins = 20) +
theme_minimal() +
labs(title = "Analysis of loudness in top songs",
x = "Loudness")
ggplot(spotify_songs_cleaned,
aes(x = loudness, y = track_popularity)) +
geom_point(alpha = 0.6) +
theme_minimal() +
labs(title = "Loudness and Track Popularity",
x = "Loudness",
y = "Track Popularity")
